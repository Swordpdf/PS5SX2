+void
+radv_ps5_cnd_deadline(uint64_t abs_ns, struct timespec *until)
+{
+   struct timespec monotonic, wall;
+   clock_gettime(CLOCK_MONOTONIC, &monotonic);
+   clock_gettime(CLOCK_REALTIME, &wall);
+   const uint64_t now = (uint64_t)monotonic.tv_sec * UINT64_C(1000000000) + (uint64_t)monotonic.tv_nsec;
+   const uint64_t ahead = abs_ns > now ? abs_ns - now : 0;
+   const uint64_t at = (uint64_t)wall.tv_sec * UINT64_C(1000000000) + (uint64_t)wall.tv_nsec + ahead;
+   until->tv_sec = (time_t)(at / UINT64_C(1000000000));
+   until->tv_nsec = (long)(at % UINT64_C(1000000000));
+}
+
+void
+radv_ps5_zero_new(void *address, size_t bytes)
+{
+   static int flush = -1;
+   if (flush < 0) {
+      const char *const value = getenv("RADV_PS5_ZERO_FLUSH");
+      flush = value != NULL && value[0] == '1';
+   }
+   if (bytes == 0)
+      return;
+#if defined(__x86_64__)
+   if (!flush) {
+      /* A streaming store writes its line to memory without reading it first
+       * and leaves no copy of the line in the caches (a cached copy is
+       * evicted); the fence makes the stores visible before what follows, as
+       * the flush's closing MFENCE did. The edges that do not fill a whole
+       * 64-byte line go the old way. */
+      uint8_t *at = address;
+      size_t left = bytes;
+      const size_t head = MIN2((size_t)(-(uintptr_t)at & 63u), left);
+      if (head) {
+         memset(at, 0, head);
+         radv_ps5_cpu_flush(at, head);
+         at += head;
+         left -= head;
+      }
+      const size_t body = left & ~(size_t)63u;
+      const __m128i zero = _mm_setzero_si128();
+      for (size_t done = 0; done < body; done += 64) {
+         _mm_stream_si128((__m128i *)(at + done), zero);
+         _mm_stream_si128((__m128i *)(at + done + 16), zero);
+         _mm_stream_si128((__m128i *)(at + done + 32), zero);
+         _mm_stream_si128((__m128i *)(at + done + 48), zero);
+      }
+      _mm_sfence();
+      if (left > body) {
+         memset(at + body, 0, left - body);
+         radv_ps5_cpu_flush(at + body, left - body);
+      }
+      return;
+   }
+#endif
+   memset(address, 0, bytes);
+   radv_ps5_cpu_flush(address, bytes);
+}
