+/* PS5SX2: framebuffer memory cleared so that the display, which reads memory
+ * and not the CPU's caches, sees it cleared: streaming stores write whole
+ * lines to memory without reading them and leave no copy in the caches (one
+ * pass, where memset with a CLFLUSH a line took three). */
+static void
+videoout_zero(void *address, size_t bytes)
+{
+#if defined(__PROSPERO__)
+   uint8_t *const at = address;
+   const __m128i zero = _mm_setzero_si128();
+   /* The sets are whole 2 MiB pieces. */
+   for (size_t done = 0; done + 64 <= bytes; done += 64) {
+      _mm_stream_si128((__m128i *)(at + done), zero);
+      _mm_stream_si128((__m128i *)(at + done + 16), zero);
+      _mm_stream_si128((__m128i *)(at + done + 32), zero);
+      _mm_stream_si128((__m128i *)(at + done + 48), zero);
+   }
+   _mm_sfence();
+#else
+   memset(address, 0, bytes);
+#endif
