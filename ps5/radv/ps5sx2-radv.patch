+ * - RADV_PS5_RECORD_CPU (0-12, set by the app before the device is made) places it at once, before the app's layout is applied.
+ * - Its line goes through the app's log hook when there is one (ps5vk_log_hook, weak: the app's deferred log, into boot.log): this
+ *   driver's stderr is not the app's. */
+static pthread_t radv_ps5_worker;
+static int radv_ps5_worker_known;
+int radv_ps5_recorder_thread(pthread_t *out);
+int
+radv_ps5_recorder_thread(pthread_t *out)
+{
+   if (!__atomic_load_n(&radv_ps5_worker_known, __ATOMIC_ACQUIRE))
+      return 0;
+   *out = radv_ps5_worker;
+   return 1;
+}
+
+extern int scePthreadSetaffinity(pthread_t thread, unsigned long long mask) __attribute__((weak));
+extern void ps5vk_log_hook(int stream, const char *text, size_t len) __attribute__((weak));
