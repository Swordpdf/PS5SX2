+/* PS5SX2: vkCmdPushDescriptorSet queued as the two above. The queue keeps a
+ * copy of the writes and of what each points to for its type (the image,
+ * buffer or texel buffer view array, the inline uniform data, the acceleration
+ * structure list); the handles in them are the application's, valid while the
+ * command buffer records (the layer's destroys wait for the worker first). */
+static bool
+radv_threaded_copyable_write(const VkWriteDescriptorSet *write)
+{
+   const VkBaseInStructure *const next = write->pNext;
+   switch (write->descriptorType) {
+   case VK_DESCRIPTOR_TYPE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+      return next == NULL;
+   case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK:
+      return next != NULL && next->sType == VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_INLINE_UNIFORM_BLOCK &&
+             next->pNext == NULL;
+   case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR:
+      return next != NULL && next->sType == VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_KHR &&
+             next->pNext == NULL;
+   default:
+      return false;
+   }
+}
+
+/* A copy of bytes at data in the queue's memory; NULL for nothing to copy, and
+ * *failed set when the memory ran out. */
+static void *
+radv_threaded_copy(struct vk_cmd_queue *queue, const void *data, size_t bytes, bool *failed)
+{
+   if (bytes == 0 || data == NULL)
+      return NULL;
+   void *const copy = linear_alloc_child(queue->ctx, bytes);
+   if (!copy) {
+      *failed = true;
+      return NULL;
+   }
+   memcpy(copy, data, bytes);
+   return copy;
+}
+
+bool
+radv_threaded_queue_CmdPushDescriptorSet(VkCommandBuffer commandBuffer, VkPipelineBindPoint pipelineBindPoint,
+                                         VkPipelineLayout layout, uint32_t set, uint32_t descriptorWriteCount,
+                                         const VkWriteDescriptorSet *pDescriptorWrites)
+{
+   VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   struct vk_cmd_queue *queue = &cmd_buffer->vk.cmd_queue;
+
+   if (vk_command_buffer_has_error(&cmd_buffer->vk))
+      return true;
+   for (uint32_t i = 0; i < descriptorWriteCount; i++) {
+      if (!radv_threaded_copyable_write(&pDescriptorWrites[i]))
+         return false;
+   }
+
+   bool failed = false;
+   struct vk_cmd_queue_entry *cmd =
+      linear_alloc_child(queue->ctx, vk_cmd_queue_type_sizes[VK_CMD_PUSH_DESCRIPTOR_SET]);
+   if (!cmd)
+      failed = true;
+   VkWriteDescriptorSet *const writes =
+      radv_threaded_copy(queue, pDescriptorWrites, sizeof(*writes) * descriptorWriteCount, &failed);
+
+   for (uint32_t i = 0; !failed && i < descriptorWriteCount; i++) {
+      const VkWriteDescriptorSet *const from = &pDescriptorWrites[i];
+      VkWriteDescriptorSet *const to = &writes[i];
+      const uint32_t count = from->descriptorCount;
+      /* What the type does not use may point anywhere: it is not copied. */
+      to->pNext = NULL;
+      to->pImageInfo = NULL;
+      to->pBufferInfo = NULL;
+      to->pTexelBufferView = NULL;
+      switch (from->descriptorType) {
+      case VK_DESCRIPTOR_TYPE_SAMPLER:
+      case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+      case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+      case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+      case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+         to->pImageInfo = radv_threaded_copy(queue, from->pImageInfo, sizeof(VkDescriptorImageInfo) * count, &failed);
+         break;
+      case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+         to->pTexelBufferView = radv_threaded_copy(queue, from->pTexelBufferView, sizeof(VkBufferView) * count, &failed);
+         break;
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+         to->pBufferInfo = radv_threaded_copy(queue, from->pBufferInfo, sizeof(VkDescriptorBufferInfo) * count, &failed);
+         break;
+      case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK: {
+         const VkWriteDescriptorSetInlineUniformBlock *const block = from->pNext;
+         VkWriteDescriptorSetInlineUniformBlock *const copy = radv_threaded_copy(queue, block, sizeof(*block), &failed);
+         if (copy)
+            copy->pData = radv_threaded_copy(queue, block->pData, block->dataSize, &failed);
+         to->pNext = copy;
+         break;
+      }
+      case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR: {
+         const VkWriteDescriptorSetAccelerationStructureKHR *const list = from->pNext;
+         VkWriteDescriptorSetAccelerationStructureKHR *const copy =
+            radv_threaded_copy(queue, list, sizeof(*list), &failed);
+         if (copy)
+            copy->pAccelerationStructures =
+               radv_threaded_copy(queue, list->pAccelerationStructures,
+                                  sizeof(VkAccelerationStructureKHR) * list->accelerationStructureCount, &failed);
+         to->pNext = copy;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   if (failed) {
+      vk_command_buffer_set_error(&cmd_buffer->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return true;
+   }
+
+   cmd->type = VK_CMD_PUSH_DESCRIPTOR_SET;
+   cmd->u.push_descriptor_set.pipeline_bind_point = pipelineBindPoint;
+   cmd->u.push_descriptor_set.layout = layout;
+   cmd->u.push_descriptor_set.set = set;
+   cmd->u.push_descriptor_set.descriptor_write_count = descriptorWriteCount;
+   cmd->u.push_descriptor_set.descriptor_writes = writes;
+   list_addtail(&cmd->cmd_link, &queue->cmds);
+   return true;
+}
