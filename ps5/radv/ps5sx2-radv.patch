+PUBLIC uint32_t wsi_videoout_refresh_millihertz(void);
+PUBLIC const char *wsi_videoout_output_status(void);
+PUBLIC void wsi_videoout_restore_default(void);
+
+/* PS5SX2: the output's refresh now, in millihertz: 119880 once a 119.88 Hz
+ * swapchain took it, 59940 otherwise, 0 before VideoOut is open. */
+PUBLIC uint32_t
+wsi_videoout_refresh_millihertz(void)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   mtx_lock(&videoout_output.lock);
+   const uint32_t millihertz = !videoout_output.opened || videoout_output.handle < 0 ? 0
+                               : videoout_output.high_frame_rate                    ? VIDEOOUT_HIGH_REFRESH_MILLIHERTZ
+                                                                                    : VIDEOOUT_REFRESH_MILLIHERTZ;
+   mtx_unlock(&videoout_output.lock);
+   return millihertz;
+}
+
+/* PS5SX2: the sentence on what the output did last ("" before the open). */
+PUBLIC const char *
+wsi_videoout_output_status(void)
+{
+   return videoout_output.status;
+}
+
+/* PS5SX2: the output back at 59.94 Hz, for a title leaving with it at
+ * 119.88 Hz (the console keeps the mode for what runs next). */
+PUBLIC void
+wsi_videoout_restore_default(void)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   mtx_lock(&videoout_output.lock);
+   if (videoout_output.high_frame_rate && videoout_output.handle >= 0) {
+      unsigned ms = 0;
+      const int restored = videoout_restore_locked(&ms);
+      videoout_output.high_frame_rate = false;
+      videoout_note_locked("59.94 Hz restored as the title leaves (0x%08x, %u ms)", (unsigned)restored, ms);
+   }
+   mtx_unlock(&videoout_output.lock);
 }
 
