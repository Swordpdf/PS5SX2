SRCS := $(SRCS) $(PCSX2)/pcsx2/MTGS.cpp $(PCSX2)/pcsx2/MTVU.cpp $(PCSX2)/pcsx2/Host.cpp
SRCS := $(SRCS) $(PCSX2)/pcsx2/PerformanceMetrics.cpp $(PCSX2)/pcsx2/PINE.cpp
