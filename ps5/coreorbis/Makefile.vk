SRCS := $(SRCS) $(PCSX2)/pcsx2/Achievements.cpp $(DEV9_SRCS)
C_SRCS := $(RCHEEVOS_SRCS) $(DEMANGLE_SRCS)

CFLAGS := -O3 -DNDEBUG -march=znver2 -msse4.1 -mavx2 -mno-vzeroupper $(NARROW_FLAGS) -D_M_X86=1 \
  -DRC_NO_THREADS=1 -DRC_HASH_NO_DISC -DRC_HASH_NO_ENCRYPTED -DRC_HASH_NO_ROM -DRC_HASH_NO_ZIP \
  -include string.h -include stdlib.h \
  -I$(PCSX2)/3rdparty/rcheevos/include -I$(PCSX2)/3rdparty/demangler/include

# vk-285-114: header dependencies (obj-vk/*.d). Without them an object whose own source didn't change kept an older
# header's layout: 1.50's VKShaderCache.o and VKSwapChain.o still saw GSDeviceVK without vk-285-113's
# m_orbis_submit_draws, so they read its fields 8 bytes off (a clean build of the same commit shows it).
CXXFLAGS += -MMD -MP
CFLAGS += -MMD -MP

# vk-285-108: CHD images (.chd). PCSX2's ChdFileReader (CDVD_SRCS) reads them through libchdr, whose codecs
# need 3rdparty/lzma's LZMA decoder and zlib and zstd; the SDK has neither of those two, so their
# decompression sources are vendored in ps5/third_party (see its README.md). The frontend reads a CHD's
# serial through libchdr as well (fe_games.cpp).
PS5_THIRD := $(PCSX2)/ps5/third_party
CHD_CSRCS := $(wildcard $(PCSX2)/3rdparty/libchdr/src/*.c) \
  $(PCSX2)/3rdparty/lzma/src/LzmaDec.c \
  $(addprefix $(PS5_THIRD)/zlib/,adler32.c crc32.c inffast.c inflate.c inftrees.c zutil.c) \
  $(wildcard $(PS5_THIRD)/zstd/lib/common/*.c) $(wildcard $(PS5_THIRD)/zstd/lib/decompress/*.c)
CHD_INCLUDES := -I$(PCSX2)/3rdparty/libchdr/include -I$(PCSX2)/3rdparty/lzma/include \
  -I$(PS5_THIRD)/zlib -I$(PS5_THIRD)/zstd/lib
C_SRCS := $(C_SRCS) $(CHD_CSRCS)

# vk-285-113: CSO (zlib) and ZSO (LZ4) images. PCSX2's CsoFileReader (CDVD_SRCS) reads a CSO's blocks with the
# vendored inflate and a ZSO's with the vendored lz4.c; the frontend's serial reader (fe_games.cpp) too.
LZ4_CSRCS := $(PS5_THIRD)/lz4/lz4.c
CSO_INCLUDES := -I$(PS5_THIRD)/lz4
C_SRCS := $(C_SRCS) $(LZ4_CSRCS)

# 2026-10-05 (AI-assisted): libarchive's reading side (RAR 4 and 5, zip), for the HD texture packs (fe_texpacks.cpp):
# archive.org's packs are RAR 5 files. ps5/third_party/README.md says what is vendored and how config.h was made.
LIBARCHIVE_CSRCS := $(wildcard $(PS5_THIRD)/libarchive/libarchive/*.c)
LIBARCHIVE_INCLUDES := -I$(PS5_THIRD)/libarchive/libarchive
C_SRCS := $(C_SRCS) $(LIBARCHIVE_CSRCS)

# 2026-10-05 (AI-assisted): mbedTLS 3.6.7, a TLS 1.2 client, for the frontend's own HTTPS (fe_https.cpp): the texture
# packs' downloads, which the console's libSceHttp2 can't make after the jailbreak. ps5/third_party/mbedtls/port has the
# config and the list of the library's sources it compiles (files.mk).
include $(PS5_THIRD)/mbedtls/port/files.mk
MBEDTLS_CSRCS := $(addprefix $(PS5_THIRD)/mbedtls/library/,$(MBEDTLS_FILES)) $(PS5_THIRD)/mbedtls/port/ps5sx2_mbedtls_platform.c
MBEDTLS_FLAGS := -DMBEDTLS_CONFIG_FILE='"ps5sx2_mbedtls_config.h"' -I$(PS5_THIRD)/mbedtls/port -I$(PS5_THIRD)/mbedtls/include
C_SRCS := $(C_SRCS) $(MBEDTLS_CSRCS)

# vk-285-135 (AI-assisted): libnfs, for games on NFS shares (orbis-shims/OrbisNfs.cpp; the console's kernel has no NFS
# client). ps5/third_party/README.md says what is vendored and how its config.h was made. link-vk.sh routes the C
# library's file calls through OrbisNfs.cpp (orbis-shims/OrbisNfs.wrap).
NFS_DIR := $(PS5_THIRD)/libnfs
NFS_CSRCS := $(wildcard $(NFS_DIR)/lib/*.c) $(wildcard $(NFS_DIR)/mount/*.c) $(wildcard $(NFS_DIR)/nfs/*.c) \
  $(wildcard $(NFS_DIR)/nfs4/*.c) $(wildcard $(NFS_DIR)/portmap/*.c)
NFS_INCLUDES := -I$(NFS_DIR)/include
C_SRCS := $(C_SRCS) $(NFS_CSRCS)

# The GL build's shims minus glprobe, GLContextPS5 and gl_loader_table; plus the
# shaderc shim and the Vulkan build's stand-ins for GL-only hooks.
SHIM_SRCS := ./orbis-shims/ProsperoInput.cpp ./orbis-shims/ProsperoCDVD.cpp \
  ./orbis-shims/cpuinfo_stubs.cpp ./orbis-shims/ProsperoMisc.cpp \
  ./orbis-shims/stubs.cpp ./orbis-shims/ProsperoUI.cpp \
  ./orbis-shims/ProsperoSaveState.cpp ./orbis-shims/ProsperoAudio.cpp \
  ./orbis-shims/ProsperoGS.cpp ./orbis-shims/ProsperoNet.cpp \
  ./orbis-shims/ProsperoZip.cpp ./orbis-shims/ProsperoCrash.cpp \
  ./orbis-shims/ProsperoDiscord.cpp \
  ./orbis-shims/dirshim.cpp ./orbis-shims/demo_renderer.cpp \
  ./orbis-shims/debug_overlay.cpp ./orbis-shims/mmapshim.cpp ./orbis-shims/orbismem.cpp ./orbis-shims/ps5dbgclient.cpp \
  ./orbis-shims/ProsperoHenJailbreak.cpp \
  ./orbis-shims/ps5_shaderc.cpp ./orbis-shims/orbis_vk.cpp ./orbis-shims/orbis_eeprof.cpp \
  ./orbis-shims/game_select.cpp ./orbis-shims/orbis_paths.cpp ./orbis-shims/orbis_memprobe.cpp \
  ./orbis-shims/ProsperoKbdMouse.cpp ./orbis-shims/ProsperoNotify.cpp ./orbis-shims/ProsperoUsbPad.cpp ./orbis-shims/ProsperoMic.cpp ./orbis-shims/ProsperoDiscDump.cpp \
  ./orbis-shims/ProsperoHTTPDownloader.cpp ./orbis-shims/ProsperoHTTPConsole.cpp ./orbis-shims/ProsperoAchievements.cpp \
  ./orbis-shims/ProsperoAchievementBrowser.cpp \
  ./orbis-shims/orbis_gs_shaders.cpp \
  ./orbis-shims/ps5_framegen.cpp \
  ./orbis-shims/OrbisNfs.cpp

SHIM_ASM := ./orbis-shims/ProsperoTLS.S

# vk-285-40: the frontend (../frontend): the cover-flow shelf of PS2 cases, rendered through the
# driver before PCSX2 starts. fe_host_main.cpp is its PC preview harness and is not built here.
FE_DIR := ../frontend
FE_SRCS := $(FE_DIR)/fe_app.cpp $(FE_DIR)/fe_covers.cpp $(FE_DIR)/fe_games.cpp \
  $(FE_DIR)/fe_renderer.cpp $(FE_DIR)/fe_sound.cpp $(FE_DIR)/fe_text.cpp $(FE_DIR)/fe_vk.cpp $(FE_DIR)/fe_ps5.cpp \
  $(FE_DIR)/fe_web.cpp $(FE_DIR)/fe_i18n.cpp $(FE_DIR)/fe_settings.cpp $(FE_DIR)/fe_options.cpp \
  $(FE_DIR)/fe_texpacks.cpp $(FE_DIR)/fe_https.cpp $(FE_DIR)/fe_https_ps5.cpp \
  $(FE_DIR)/fe_patchdl.cpp $(FE_DIR)/fe_bios.cpp
# vk-285-50: Project Nayuki's QR Code generator (MIT, C) for the shelf's QR tile, and the files
# fe_ps5.cpp embeds from frontend/assets (the settings page, its icons, Font Awesome's brands font).
FE_CSRCS := $(FE_DIR)/third_party/qrcodegen/qrcodegen.c
FE_ASSETS := $(wildcard $(FE_DIR)/assets/web/*) $(wildcard $(FE_DIR)/assets/fonts/*.otf) $(FE_DIR)/assets/presets.ini
FE_HDRS := $(wildcard $(FE_DIR)/*.h) $(FE_DIR)/fe_shaders.inc $(FE_DIR)/third_party/qrcodegen/qrcodegen.h $(FE_ASSETS)

SRCS := $(SRCS) $(PCSX2)/pcsx2/USB/usb-mic/usb-mic.cpp \
  $(PCSX2)/pcsx2/USB/usb-mic/usb-headset.cpp \
  $(PCSX2)/pcsx2/USB/usb-printer/usb-printer.cpp \
  $(PCSX2)/pcsx2/USB/usb-eyetoy/usb-eyetoy-webcam.cpp \
  $(PCSX2)/pcsx2/USB/usb-eyetoy/cam-noop.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/lg/lg_ff.cpp

PS2_SRCS := $(PCSX2)/pcsx2/ps2/BiosTools.cpp \
  $(PCSX2)/pcsx2/ps2/pgif.cpp \
  $(PCSX2)/pcsx2/ps2/Iop/IopHwRead.cpp \
  $(PCSX2)/pcsx2/ps2/Iop/IopHwWrite.cpp \
  $(PCSX2)/pcsx2/ps2/Iop/PsxBios.cpp

SRCS := $(SRCS) $(PS2_SRCS)

COMMON_SRCS := $(PCSX2)/common/AlignedMalloc.cpp \
  $(PCSX2)/common/Console.cpp \
  $(PCSX2)/common/DynamicLibrary.cpp \
  $(PCSX2)/common/Error.cpp \
  $(PCSX2)/common/FastJmp.cpp \
  $(PCSX2)/common/FileSystem.cpp \
  $(PCSX2)/common/HTTPDownloader.cpp \
  $(PCSX2)/common/MemoryInterface.cpp \
  $(PCSX2)/common/MemorySettingsInterface.cpp \
  $(PCSX2)/common/MD5Digest.cpp \
  $(PCSX2)/common/Perf.cpp \
  $(PCSX2)/common/ProgressCallback.cpp \
  $(PCSX2)/common/ReadbackSpinManager.cpp \
  $(PCSX2)/common/Semaphore.cpp \
  $(PCSX2)/common/SettingsWrapper.cpp \
  $(PCSX2)/common/SmallString.cpp \
  $(PCSX2)/common/StringUtil.cpp \
  $(PCSX2)/common/TextureDecompress.cpp \
  $(PCSX2)/common/Timer.cpp \
  $(PCSX2)/common/WAVWriter.cpp \
  $(PCSX2)/common/Linux/LnxHostSys.cpp \
  $(PCSX2)/common/Linux/LnxThreads.cpp \
  $(PCSX2)/common/emitter/bmi.cpp \
  $(PCSX2)/common/emitter/fpu.cpp \
  $(PCSX2)/common/emitter/groups.cpp \
  $(PCSX2)/common/emitter/jmp.cpp \
  $(PCSX2)/common/emitter/legacy.cpp \
  $(PCSX2)/common/emitter/legacy_sse.cpp \
  $(PCSX2)/common/emitter/movs.cpp \
  $(PCSX2)/common/emitter/simd.cpp \
  $(PCSX2)/common/emitter/x86emitter.cpp \
  $(PCSX2)/3rdparty/fmt/src/format.cc

USB_SRCS := $(PCSX2)/pcsx2/USB/USB.cpp \
  $(PCSX2)/pcsx2/USB/deviceproxy.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/bus.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/core.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/desc.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/hid.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/input-keymap-qcode-to-qnum.cpp \
  $(PCSX2)/pcsx2/USB/qemu-usb/usb-ohci.cpp \
  $(PCSX2)/pcsx2/USB/shared/ringbuffer.cpp \
  $(PCSX2)/pcsx2/USB/usb-hid/usb-hid.cpp \
  $(PCSX2)/pcsx2/USB/usb-lightgun/guncon2.cpp \
  $(PCSX2)/pcsx2/USB/usb-msd/usb-msd.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-buzz.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-gametrak.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-realplay.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-seamic.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-train.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-trance-vibrator.cpp \
  $(PCSX2)/pcsx2/USB/usb-pad/usb-turntable.cpp

SRCS := $(SRCS) $(COMMON_SRCS) $(USB_SRCS) $(PCSX2)/tests/ctest/core/StubHost.cpp

OBJDIR := obj-vk
OBJS := $(patsubst $(PCSX2)/%.cpp,$(OBJDIR)/%.o,$(filter %.cpp,$(SRCS))) \
  $(patsubst $(PCSX2)/%.cc,$(OBJDIR)/%.o,$(filter %.cc,$(SRCS))) \
  $(patsubst $(RYML)/%.cpp,$(OBJDIR)/ryml/%.o,$(RYML_SRCS)) \
  $(patsubst ./%.cpp,$(OBJDIR)/shim/%.o,$(SHIM_SRCS)) \
  $(patsubst $(PCSX2)/%.c,$(OBJDIR)/%.o,$(C_SRCS)) \
  $(patsubst ./%.S,$(OBJDIR)/shim/%.o,$(SHIM_ASM)) \
  $(patsubst $(FE_DIR)/%.cpp,$(OBJDIR)/frontend/%.o,$(FE_SRCS)) \
  $(patsubst $(FE_DIR)/%.c,$(OBJDIR)/frontend/%.o,$(FE_CSRCS))

# vk-285-108: the CHD code's flags (see CHD_CSRCS): single-threaded LZMA, zstd's C Huffman decoder (its
# amd64 .S isn't vendored) without the legacy formats or the trace hooks.
$(patsubst $(PCSX2)/%.c,$(OBJDIR)/%.o,$(CHD_CSRCS)): CFLAGS += $(CHD_INCLUDES) -DZ7_ST \
  -DZSTD_DISABLE_ASM=1 -DZSTD_LEGACY_SUPPORT=0 -DZSTD_NO_TRACE=1
$(OBJDIR)/pcsx2/CDVD/ChdFileReader.o $(OBJDIR)/frontend/fe_games.o: CXXFLAGS += -I$(PCSX2)/3rdparty/libchdr/include
$(OBJDIR)/pcsx2/CDVD/CsoFileReader.o $(OBJDIR)/frontend/fe_games.o: CXXFLAGS += $(CSO_INCLUDES)
# vk-285-113: the settings page's server thread runs fe_web.cpp's handlers and fe_games.cpp's scans; a 64 KB array in
# one of them ended the app the first time the page opened. Warn about any frame over 12 KB in them (vk-285-114: and in
# fe_settings.cpp, the page's file code the options sheet shares).
$(OBJDIR)/frontend/fe_web.o $(OBJDIR)/frontend/fe_games.o $(OBJDIR)/frontend/fe_settings.o: CXXFLAGS += -Wframe-larger-than=12288
# 2026-10-05: libarchive, built with its own config (and zlib's headers) and quietly: it isn't our code to change.
$(patsubst $(PCSX2)/%.c,$(OBJDIR)/%.o,$(LIBARCHIVE_CSRCS)): CFLAGS += -DHAVE_CONFIG_H -I$(PS5_THIRD)/libarchive \
  $(LIBARCHIVE_INCLUDES) -I$(PS5_THIRD)/zlib -w
$(OBJDIR)/frontend/fe_texpacks.o: CXXFLAGS += $(LIBARCHIVE_INCLUDES) -Wframe-larger-than=12288
# vk-285-134: a BIOS taken out of a .zip/.rar/.7z (fe_bios.cpp) reads it with libarchive too.
$(OBJDIR)/frontend/fe_bios.o: CXXFLAGS += $(LIBARCHIVE_INCLUDES)
# vk-285-135: libnfs with its config and quietly (not our code to change), and the file that uses it.
$(patsubst $(PCSX2)/%.c,$(OBJDIR)/%.o,$(NFS_CSRCS)): CFLAGS += -DHAVE_CONFIG_H -DHAVE_NFS4_2 "-D_U_=__attribute__((unused))" \
  -I$(NFS_DIR) $(NFS_INCLUDES) -I$(NFS_DIR)/include/nfsc -I$(NFS_DIR)/mount -I$(NFS_DIR)/nfs -I$(NFS_DIR)/nfs4 \
  -I$(NFS_DIR)/portmap -w
$(OBJDIR)/shim/orbis-shims/OrbisNfs.o: CXXFLAGS += $(NFS_INCLUDES)
# 2026-10-05: mbedTLS with its config (warnings on: it builds clean), and the client that uses it.
$(patsubst $(PCSX2)/%.c,$(OBJDIR)/%.o,$(MBEDTLS_CSRCS)): CFLAGS += $(MBEDTLS_FLAGS) -I$(PS5_THIRD)/mbedtls/library
$(OBJDIR)/frontend/fe_https.o: CXXFLAGS += $(MBEDTLS_FLAGS) -Wframe-larger-than=12288
$(OBJDIR)/frontend/fe_https.o: $(FE_DIR)/fe_https_roots.inc
# 2026-10-05 (AI-assisted), an experiment: ORBIS_IME_IMPORT=1 imports libSceImeDialog (the PS5's keyboard for the
# RetroAchievements panel) at the app's start instead of loading it when first needed (fe_ps5.cpp). An app whose import
# the system refuses doesn't start, so it is off by default. The flag isn't a dependency of the object: rebuild it with
# `make -f Makefile.vk -B obj-vk/frontend/fe_ps5.o ORBIS_IME_IMPORT=1` (and again without, to go back). Needs testing.
ORBIS_IME_IMPORT ?= 0
ifeq ($(ORBIS_IME_IMPORT),1)
$(OBJDIR)/frontend/fe_ps5.o: CXXFLAGS += -DPS5SX2_IME_IMPORT=1
endif

all: $(OBJS)
	@echo "VK COMPILE OK: $(words $(OBJS)) objects"

# The object list link-vk.sh links (the GL build's conv.sh finds them with find).
objects.txt: $(OBJS)
	@printf '%s\n' $(OBJS) > $@

$(OBJDIR)/%.o: $(PCSX2)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# make has no header-dependency tracking: microVU*.inl are #included via
# microVU.h, so list them explicitly (a stale microVU.o ships old JIT code).
$(OBJDIR)/pcsx2/x86/microVU.o: $(PCSX2)/pcsx2/x86/microVU.h $(PCSX2)/pcsx2/x86/microVU_*.inl
$(OBJDIR)/pcsx2/GS/GS.o: ./include-orbis/GSDeviceOrbis.h

$(OBJDIR)/%.o: $(PCSX2)/%.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# soundtouch throws (ST_THROW_RT_ERROR); keep unwinding on for it alone.
$(OBJDIR)/3rdparty/soundtouch/%.o: $(PCSX2)/3rdparty/soundtouch/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -fexceptions -c $< -o $@

$(OBJDIR)/pcsx2/Host/AudioStream.o: $(PCSX2)/pcsx2/Host/AudioStream.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -fexceptions -c $< -o $@

$(OBJDIR)/ryml/%.o: $(RYML)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# vk-285-115: the GS shader sources, embedded from PCSX2's bin/resources/shaders (.incbin), for a console with no
# resources folder. The files are listed so an edited shader rebuilds the object.
ORBIS_GS_SHADERS := $(wildcard $(PCSX2)/bin/resources/shaders/vulkan/*.glsl) $(wildcard $(PCSX2)/bin/resources/shaders/common/*)
$(OBJDIR)/shim/orbis-shims/orbis_gs_shaders.o: ./orbis-shims/orbis_gs_shaders.cpp ./include-orbis/OrbisGSShaders.h $(ORBIS_GS_SHADERS)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -DORBIS_GS_SHADER_DIR=\"$(abspath $(PCSX2)/bin/resources/shaders)\" -c $< -o $@

# 2026-10-05 (AI-assisted): the notification relay payload (notify-relay/notify_relay.c), built with the payload SDK's
# own link (it imports libSceNotification) and embedded in ProsperoNotify.o (.incbin): PS5SX2's process can't load
# libSceNotification on 11.40/12.00, so rich toasts go through the console's ELF loader (see ProsperoNotify.cpp).
NOTIFY_RELAY_ELF := $(OBJDIR)/notify-relay/notify_relay.elf
$(NOTIFY_RELAY_ELF): ./notify-relay/notify_relay.c
	@mkdir -p $(dir $@)
	$(CC) -Wall -Werror -O2 -o $@ $< -lSceNotification
	$(PS5_PAYLOAD_SDK)/bin/prospero-strip $@
$(OBJDIR)/shim/orbis-shims/ProsperoNotify.o: ./orbis-shims/ProsperoNotify.cpp $(NOTIFY_RELAY_ELF)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -DORBIS_NOTIFY_RELAY_ELF=\"$(abspath $(NOTIFY_RELAY_ELF))\" -c $< -o $@

# The shaderc shim includes glslang's C interface.
$(OBJDIR)/shim/orbis-shims/ps5_shaderc.o: ./orbis-shims/ps5_shaderc.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(GLSLANG) -c $< -o $@

$(OBJDIR)/shim/%.o: ./%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/shim/%.o: ./%.S
	@mkdir -p $(dir $@)
	$(CC) -march=znver2 -c $< -o $@

# The frontend: its fonts are embedded from PCSX2's resources (fe_ps5.cpp, .incbin).
$(OBJDIR)/frontend/%.o: $(FE_DIR)/%.cpp $(FE_HDRS)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(FE_DIR) -DFE_FONT_DIR=\"$(PCSX2)/bin/resources/fonts\" \
	  -DFE_ASSET_DIR=\"$(abspath $(FE_DIR)/assets)\" -c $< -o $@

$(OBJDIR)/frontend/%.o: $(FE_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) -O2 -DNDEBUG -march=znver2 -std=c99 -c $< -o $@

$(OBJDIR)/%.o: $(PCSX2)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

-include $(OBJS:.o=.d)

clean:
	rm -rf $(OBJDIR) objects.txt

.PHONY: all clean
