# PCSX2 PS5 port -- the Vulkan build.
#
# GSDeviceVK on the Vulkan driver linked into the eboot (Swordpdf/PS5HB_Vulkan).
# Same sources and compiler flags as the GL build (Makefile, build 285), minus
# OpenGL: the GL renderer, glad and the GL shims go, because the ps5-opengl
# runtime and the driver both carry Mesa and psbc. Added: PCSX2's Vulkan backend
# and the static shaderc shim over glslang (orbis-shims/ps5_shaderc.cpp).
# Objects go to obj-vk/, so the two builds never share an object.
#
#   make -f Makefile.vk -j2        compile everything
#   bash link-vk.sh                link, sign -> $(VK_OUT)/app/eboot.bin
#
# Run it from this folder. PCSX2 is this repository's root; the other dependencies
# come from PS5SX2_DEPS (see ps5/README.md) unless set one by one.

VK_MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
# vk-285-131: 1.9's fe_https.o rule (its roots file) came before "all:" and became the default goal, so a bare
# `make -f Makefile.vk -j2` built that one object and link-vk.sh compiled the rest one at a time.
.DEFAULT_GOAL := all
PCSX2           ?= $(abspath $(VK_MAKEFILE_DIR)../..)
RYML            ?= $(PS5SX2_DEPS)/ryml
SHADERC_INCLUDE ?= $(PS5SX2_DEPS)/shaderc/libshaderc/include
GLSLANG         ?= $(PS5SX2_DEPS)/glslang
PS5_PAYLOAD_SDK ?= $(PS5SX2_DEPS)/sdk285
ifeq ($(wildcard $(PS5_PAYLOAD_SDK)/bin/prospero-clang++),)
$(error no SDK at "$(PS5_PAYLOAD_SDK)": set PS5SX2_DEPS or PS5_PAYLOAD_SDK, see ps5/README.md)
endif

CXX := $(PS5_PAYLOAD_SDK)/bin/prospero-clang++
CC  := $(PS5_PAYLOAD_SDK)/bin/prospero-clang
export PS5_PAYLOAD_SDK

# vk-285-91: -mno-vzeroupper. The GS thread's profiles had 5-7% of their samples right after a VZEROUPPER;
# Zen 2 has no SSE/AVX transition penalty for it to avoid (the upper halves are renamed apart), and leaving
# it out changes no results (the ABI doesn't keep the upper halves across calls). main-boot [vzubench]
# measures the instruction.
# vk-285-102: LLVM's DAG combiner narrows "x |= constant" and "x &= ~constant" on a memory word to a byte (or
# 16-bit) operation on the byte the constant touches. A later load of the whole word can't take its value from
# the narrower store and waits until the store reaches the cache, behind every older store in the queue.
# vk-285-101's GS profile had 3.8% of the thread on one such load (ApplyTFXState's m_dirty_flags after
# SetScissor's orb); PCSX2's register and flag words (VIF/DMA/GIF bitfields, EE state) get the same treatment.
# ORBIS_STORE_NARROWING=1 builds with the narrowing as before.
ORBIS_STORE_NARROWING ?= 0
ifeq ($(ORBIS_STORE_NARROWING),0)
NARROW_FLAGS := -mllvm -combiner-reduce-load-op-store-width=false
else
NARROW_FLAGS :=
endif
CXXFLAGS := -Wall -g -O3 -DNDEBUG -std=c++20 -march=znver2 -msse4.1 -mavx2 -mno-vzeroupper $(NARROW_FLAGS) \
  -D_M_X86=1 -D__POSIX__=1 -DXBYAK_NO_EXCEPTION \
  -DOVERRIDE_HOST_PAGE_SIZE=0x4000 -DOVERRIDE_HOST_CACHE_LINE_SIZE=64 \
  -fno-exceptions -fno-rtti -ffunction-sections -fdata-sections \
  -fvisibility=hidden \
  -Wno-macro-redefined -Wno-unused-function \
  -include common/Threading.h \
  -I./include-orbis -I$(PCSX2)/ps5/third_party/zlib -I$(PCSX2) -I$(PCSX2)/pcsx2 -I$(PCSX2)/3rdparty/include \
  -I$(PCSX2)/3rdparty/fmt/include \
  -I$(PCSX2)/3rdparty/fast_float/include \
  -I$(PCSX2)/3rdparty/rapidjson/include \
  -I$(PCSX2)/3rdparty/simpleini/include \
  -I$(PCSX2)/3rdparty/ccc/src \
  -I$(PCSX2)/3rdparty/xbyak \
  -I$(PCSX2)/3rdparty/zydis/include \
  -I$(PCSX2)/3rdparty/zydis/dependencies/zycore/include \
  -I$(PCSX2)/3rdparty/discord-rpc/include \
  -I$(PCSX2)/3rdparty/demangler/include \
  -I$(PCSX2)/3rdparty/rcheevos/include \
  -I$(PCSX2)/3rdparty/imgui/include \
  -I$(PCSX2)/3rdparty/soundtouch/soundtouch \
  -I$(PCSX2)/3rdparty/freesurround/include \
  -I$(RYML)/src \
  -I$(RYML)/ext/c4core.src \
  -I$(PCSX2)/3rdparty/vulkan/include -I$(SHADERC_INCLUDE) \
  -DENABLE_VULKAN=1 -DORBIS_VULKAN=1 -DPS5SX2_ACHIEVEMENTS=1

RYML_SRCS := $(RYML)/src/c4/yml/common.cpp \
  $(RYML)/src/c4/yml/emit_buf.cpp \
  $(RYML)/src/c4/yml/emit_file.cpp \
  $(RYML)/src/c4/yml/node_type.cpp \
