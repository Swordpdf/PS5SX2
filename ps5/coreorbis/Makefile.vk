DEV9_SRCS := $(shell find $(PCSX2)/pcsx2/DEV9 -name '*.cpp' -not -path '*/Win32/*' -not -name 'pcap_io.cpp')

RCHEEVOS := $(PCSX2)/3rdparty/rcheevos
RCHEEVOS_SRCS := $(filter-out %/rc_libretro.c %/rc_client_raintegration.c %/rhash/hash.c %/rhash/cdreader.c, $(wildcard $(RCHEEVOS)/src/*.c $(RCHEEVOS)/src/rapi/*.c $(RCHEEVOS)/src/rcheevos/*.c $(RCHEEVOS)/src/rhash/*.c))

DEMANGLE_SRCS := $(PCSX2)/3rdparty/demangler/src/cp-demangle.c \
  $(PCSX2)/3rdparty/demangler/src/cplus-dem.c \
  $(PCSX2)/3rdparty/demangler/src/d-demangle.c \
  $(PCSX2)/3rdparty/demangler/src/dyn-string.c \
  $(PCSX2)/3rdparty/demangler/src/safe-ctype.c \
  $(PCSX2)/3rdparty/demangler/src/xmalloc.c \
